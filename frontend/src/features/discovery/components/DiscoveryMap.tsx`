import React, { useEffect, useRef, useState } from 'react';
import mapboxgl from 'mapbox-gl';
import 'mapbox-gl/dist/mapbox-gl.css';

interface Listing {
    id: string;
    title: string;
    asset: {
        latitude: number;
        longitude: number;
        boundary_geojson?: any;
    };
}

interface DiscoveryMapProps {
    listings: Listing[];
}

const DiscoveryMap: React.FC<DiscoveryMapProps> = ({ listings }) => {
    const mapContainerRef = useRef<HTMLDivElement>(null);
    const mapRef = useRef<mapboxgl.Map | null>(null);
    const [accessToken, setAccessToken] = useState<string>('');

    useEffect(() => {
        // In a real app, this would come from an API call to /api/settings/
        // For now, we use a placeholder. The user should add their key in SystemSettings.
        const token = 'pk.eyJ1Ijoic2FtcGxlIiwiaSjoic2FtcGxlIn0.placeholder';
        setAccessToken(token);
    }, []);

    useEffect(() => {
        if (!mapContainerRef.current || !accessToken) return;

        mapboxgl.accessToken = accessToken;

        const map = new mapboxgl.Map({
            container: mapContainerRef.current,
            style: 'mapbox://styles/mapbox/dark-v11', // Luxury Dark Mode
            center: [30.0619, -1.9441], // Kigali, Rwanda
            zoom: 12,
            pitch: 45,
        });

        mapRef.current = map;

        map.on('load', () => {
            // Add listings as markers
            listings.forEach(listing => {
                if (listing.asset.latitude && listing.asset.longitude) {
                    // Create a custom HTML element for the marker
                    const el = document.createElement('div');
                    el.className = 'w-6 h-6 bg-green-500 rounded-full border-2 border-white shadow-lg cursor-pointer hover:scale-125 transition-transform';
                    el.title = listing.title;

                    new mapboxgl.Marker(el)
                        .setLngLat([listing.asset.longitude, listing.asset.latitude])
                        .setPopup(new mapboxgl.Popup().setHTML(`
                            <div class="p-2 font-sans text-black">
                                <h3 class="font-bold">${listing.title}</h3>
                                <p class="text-xs text-zinc-600">Click to view details</p>
                            </div>
                        `))
                        .addTo(map);

                    // If the asset has boundary GeoJSON, render it as a layer
                    if (listing.asset.boundary_geojson) {
                        map.addSource(`boundary-${listing.id}`, {
                            type: 'geojson',
                            data: listing.asset.boundary_geojson
                        });

                        map.addLayer({
                            id: `boundary-layer-${listing.id}`,
                            type: 'fill',
                            source: `boundary-${listing.id}`,
                            paint: {
                                'fill-color': '#10b981',
                                'fill-opacity': 0.3,
                                'fill-outline-color': '#10b981'
                            }
                        });
                    }
                }
            });
        });

        return () => map.remove();
    }, [accessToken, listings]);

    return (
        <div className="w-full h-full relative bg-zinc-900 overflow-hidden">
            {!accessToken && (
                <div className="absolute inset-0 z-10 flex items-center justify-center bg-black/60 backdrop-blur-sm">
                    <p className="text-zinc-400 font-medium px-6 py-3 bg-zinc-900 border border-zinc-800 rounded-full">
                        Mapbox Access Token Required
                    </p>
                </div>
            )}
            <div ref={mapContainerRef} className="w-full h-full" />

            <div className="absolute bottom-6 left-6 z-10 pointer-events-none">
                <div className="px-4 py-2 bg-black/60 backdrop-blur-md text-white text-xs font-bold rounded-full border border-white/20">
                    GIS Intelligence Layer Active
                </div>
            </div>
        </div>
    );
};

export default DiscoveryMap;
