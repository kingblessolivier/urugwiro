  Heart,
  Mail,
  Users,
  PhoneCall,
  Layers,
  Award,
  Building2,
  Car,
  Compass,
  Eye,
  Fuel,
  Gauge,
  Home,
  Key,
  Map,
  Navigation,
  Phone,
  Truck,
  Waves,
  Wifi,
  Zap,
  Droplets,
  Ruler,
  Check,
  AlertCircle,
  FileText,
  DoorOpen,
  Sparkle,
  ZoomIn,
  ZoomOut,
  Maximize2,
  Pencil,
  Trash2,
  Settings,
  PlusCircle,
  Edit3,
  Camera,
  Plus,
} from 'lucide-react';
