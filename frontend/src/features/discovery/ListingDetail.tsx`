// Setup leaflet default marker
const customMarkerIcon = new L.Icon({
  iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
  iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
  shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
  iconSize: [25, 41],
  iconAnchor: [12, 41],
  popupAnchor: [1, -34],
  shadowSize: [41, 41],
});

interface ListingDetailProps {
  listingId: string;
  onBack: () => void;
}

type HeroDisplayMode = 'photos' | '3d' | 'map';

const ListingDetail: React.FC<ListingDetailProps> = ({ listingId, onBack }) => {
  const queryClient = useQueryClient();
  const [activeMedia, setActiveMedia] = useState(0);
  const [heroMode, setHeroMode] = useState<HeroDisplayMode>('photos');
  const [isZoomLightboxOpen, setIsZoomLightboxOpen] = useState(false);

  // Selected apartment unit (if prospective tenant/buyer selects a specific unit)
  const [selectedApartmentUnit, setSelectedApartmentUnit] = useState<{ unit: ApartmentUnit; floor: number } | null>(null);

  // Modals state
  const [isOfferModalOpen, setIsOfferModalOpen] = useState(false);
  const [isVisitModalOpen, setIsVisitModalOpen] = useState(false);
  const [isInquiryModalOpen, setIsInquiryModalOpen] = useState(false);
  const [offerSuccess, setOfferSuccess] = useState(false);
  const [visitSuccess, setVisitSuccess] = useState(false);
  const [inquirySuccess, setInquirySuccess] = useState(false);

  // Inquiry Form state
  const [inquiryName, setInquiryName] = useState('');
  const [inquiryEmail, setInquiryEmail] = useState('');
  const [inquiryPhone, setInquiryPhone] = useState('');
  const [inquiryMessage, setInquiryMessage] = useState('');

  // Offer Form state
  const [offerAmount, setOfferAmount] = useState<number>(0);
  const [escrowPercent, setEscrowPercent] = useState<number>(10);
  const [financingType, setFinancingType] = useState<string>('cash');
  const [closingDate, setClosingDate] = useState<string>('');
  const [offerNotes, setOfferNotes] = useState<string>('');

  // AI Valuation Advisor state
  const [isAiChecking, setIsAiChecking] = useState(false);
  const [aiAnalysis, setAiAnalysis] = useState<any | null>(null);

  // Visit Form state
  const [visitDate, setVisitDate] = useState<string>('');
  const [visitTimeSlot, setVisitTimeSlot] = useState<string>('10:00 - 12:00');
  const [visitNotes, setVisitNotes] = useState<string>('');
  const [visitName, setVisitName] = useState<string>('');
  const [visitPhone, setVisitPhone] = useState<string>('');
  const [visitEmail, setVisitEmail] = useState<string>('');

  // Like & Favorites state
  const [isLiked, setIsLiked] = useState<boolean>(false);
  const [likesCount, setLikesCount] = useState<number>(0);

  // Guest lead capture modal state (for unauthenticated visitors saving/liking asset)
  const [isGuestLeadModalOpen, setIsGuestLeadModalOpen] = useState(false);
  const [guestName, setGuestName] = useState('');
  const [guestPhone, setGuestPhone] = useState('');
  const [guestEmail, setGuestEmail] = useState('');
  const [guestSuccess, setGuestSuccess] = useState(false);
  const [guestLoading, setGuestLoading] = useState(false);

  // Leads Ledger filter tab (for Admin/Seller)
  const [leadsTab, setLeadsTab] = useState<'all' | 'inquiries' | 'visits' | 'likes'>('all');

  const { data: listing, isLoading } = useQuery({
    queryKey: ['listing-detail', listingId],
    queryFn: async () => {
      const response = await api.listings.get(listingId);
      return response.data;
    },
  });

  // Query active deal for this listing (if any)
  const { data: dealsData } = useQuery({
    queryKey: ['listing-deals', listingId],
    queryFn: async () => {
      const res = await api.deals.list();
      const list = Array.isArray(res.data) ? res.data : [];
      return list.find((d: any) => String(d.listing?.id || d.listing) === String(listingId)) ?? null;
    },
  });

  // Auth & Management Authority
  const { user } = useAuth();

  // Section Edit Modal state
  const [editingSection, setEditingSection] = useState<EditableSectionKey | null>(null);

  // Add/Edit Discovery Modal state
  const [isDiscoveryModalOpen, setIsDiscoveryModalOpen] = useState(false);
  const [editingDiscovery, setEditingDiscovery] = useState<DiscoverySectionItem | null>(null);

  // Custom Discoveries state (synced with API listing.custom_sections + localStorage)
  const [customSections, setCustomSections] = useState<DiscoverySectionItem[]>(() => {
    try {
      const cached = localStorage.getItem(`urugwiro_custom_sections_${listingId}`);
      if (cached) return JSON.parse(cached);
    } catch {
      // ignore
    }
    return [];
  });

  // When listing data loads, sync customSections if backend provides it
  React.useEffect(() => {
    if (listing?.custom_sections && Array.isArray(listing.custom_sections)) {
      setCustomSections(listing.custom_sections);
      try {
        localStorage.setItem(`urugwiro_custom_sections_${listingId}`, JSON.stringify(listing.custom_sections));
      } catch {
        // ignore
      }
    }
  }, [listing?.custom_sections, listingId]);

  // When listing data loads, sync likes state
  React.useEffect(() => {
    if (listing) {
      if (typeof listing.is_liked === 'boolean') setIsLiked(listing.is_liked);
      if (typeof listing.likes_count === 'number') setLikesCount(listing.likes_count);
    }
  }, [listing]);

  // Prefill contact inputs from authenticated user
  React.useEffect(() => {
    if (user) {
      const fullName = (user as any).name || `${user.first_name || ''} ${user.last_name || ''}`.trim() || user.username || '';
      const email = user.email || '';
      const phone = (user as any).phone_number || '';
      if (fullName) {
        setInquiryName((prev) => prev || fullName);
        setVisitName((prev) => prev || fullName);
        setGuestName((prev) => prev || fullName);
      }
      if (email) {
        setInquiryEmail((prev) => prev || email);
        setVisitEmail((prev) => prev || email);
        setGuestEmail((prev) => prev || email);
      }
      if (phone) {
        setInquiryPhone((prev) => prev || phone);
        setVisitPhone((prev) => prev || phone);
        setGuestPhone((prev) => prev || phone);
      }
    }
  }, [user]);

  // Like toggle handler
  const handleToggleLike = async () => {
    if (user) {
      try {
        const res = await api.listings.like(listingId);
        setIsLiked(Boolean(res.data.liked));
        if (typeof res.data.total_likes === 'number') {
          setLikesCount(res.data.total_likes);
        } else {
          setLikesCount((prev) => (res.data.liked ? prev + 1 : Math.max(0, prev - 1)));
        }
        queryClient.invalidateQueries({ queryKey: ['listing-detail', listingId] });
      } catch (err) {
        console.error('Failed to toggle like:', err);
      }
    } else {
      setIsGuestLeadModalOpen(true);
    }
  };

  const handleGuestLeadSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!guestName.trim() || !guestPhone.trim()) return;
    setGuestLoading(true);
    try {
      const res = await api.listings.like(listingId, {
        name: guestName.trim(),
        phone: guestPhone.trim(),
        email: guestEmail.trim(),
      });
      setIsLiked(true);
      if (typeof res.data.total_likes === 'number') {
        setLikesCount(res.data.total_likes);
      } else {
        setLikesCount((prev) => prev + 1);
      }
      setGuestSuccess(true);
      queryClient.invalidateQueries({ queryKey: ['listing-detail', listingId] });
      setTimeout(() => {
        setIsGuestLeadModalOpen(false);
        setGuestSuccess(false);
      }, 2200);
    } catch (err) {
      console.error('Failed to register interest:', err);
    } finally {
      setGuestLoading(false);
    }
  };

  // Handler to save/update a discovery section
  const handleSaveDiscovery = async (newSection: DiscoverySectionItem) => {
    const exists = customSections.some((s) => s.id === newSection.id);
    let updated: DiscoverySectionItem[];
    if (exists) {
      updated = customSections.map((s) => (s.id === newSection.id ? newSection : s));
    } else {
      updated = [...customSections, newSection];
    }
    setCustomSections(updated);
    try {
      localStorage.setItem(`urugwiro_custom_sections_${listingId}`, JSON.stringify(updated));
    } catch {
      // ignore
    }

    // Persist to backend
    try {
      await api.seller.updateListing(listingId, { custom_sections: updated });
      queryClient.invalidateQueries({ queryKey: ['listing-detail', listingId] });
    } catch (err) {
      console.warn('Backend custom_sections sync fallback to local storage:', err);
    }
  };

  // Handler to delete a discovery section
  const handleDeleteDiscovery = async (sectionId: string) => {
    const updated = customSections.filter((s) => s.id !== sectionId);
    setCustomSections(updated);
    try {
      localStorage.setItem(`urugwiro_custom_sections_${listingId}`, JSON.stringify(updated));
    } catch {
      // ignore
    }

    // Persist to backend
    try {
      await api.seller.updateListing(listingId, { custom_sections: updated });
      queryClient.invalidateQueries({ queryKey: ['listing-detail', listingId] });
    } catch (err) {
      console.warn('Backend custom_sections sync fallback to local storage:', err);
    }
  };

  // Quick status switcher mutation
  const handleQuickStatusChange = async (newStatus: string) => {
    try {
      await api.seller.updateListing(listingId, { status: newStatus });
      queryClient.invalidateQueries({ queryKey: ['listing-detail', listingId] });
    } catch (err) {
      console.error('Failed to update status:', err);
    }
  };

  // Offer Mutation
  const offerMutation = useMutation({
    mutationFn: async (data: any) => {
      return api.offers.create(data);
    },
    onSuccess: () => {
      setOfferSuccess(true);
      queryClient.invalidateQueries({ queryKey: ['admin-offers'] });
      setTimeout(() => {
        setIsOfferModalOpen(false);
        setOfferSuccess(false);
      }, 2000);
    },
  });

  // Visit Mutation
  const visitMutation = useMutation({
    mutationFn: async (data: any) => {
      return api.visits.create(data);
    },
    onSuccess: () => {
      setVisitSuccess(true);
      queryClient.invalidateQueries({ queryKey: ['listing-detail', listingId] });
      queryClient.invalidateQueries({ queryKey: ['admin-visits'] });
      queryClient.invalidateQueries({ queryKey: ['admin-enquiries'] });
      queryClient.invalidateQueries({ queryKey: ['seller-inquiries'] });
      setTimeout(() => {
        setIsVisitModalOpen(false);
        setVisitSuccess(false);
      }, 2000);
    },
  });

  // Inquiry Mutation
  const inquiryMutation = useMutation({
    mutationFn: async (data: any) => {
      return api.public.contactSubmit(data);
    },
    onSuccess: () => {
      setInquirySuccess(true);
      queryClient.invalidateQueries({ queryKey: ['listing-detail', listingId] });
      queryClient.invalidateQueries({ queryKey: ['admin-enquiries'] });
      queryClient.invalidateQueries({ queryKey: ['seller-inquiries'] });
      setTimeout(() => {
        setIsInquiryModalOpen(false);
        setInquirySuccess(false);
        setInquiryMessage('');
      }, 2000);
    },
  });

  // Run NVIDIA NIM AI Offer Feasibility Check
  const handleAiFeasibilityCheck = async () => {
    if (!offerAmount || offerAmount <= 0) return;
    setIsAiChecking(true);
    setAiAnalysis(null);
    try {
      const res = await api.ai.analyzeOffer(listingId, offerAmount);
      setAiAnalysis(res.data);
    } catch (err: any) {
      setAiAnalysis({
        error: err.response?.data?.error || 'AI analysis unavailable',
        fairness_score: 0,
        analysis: 'Valuation intelligence service is currently unavailable. You may submit your offer directly to the seller.'
      });
    } finally {
      setIsAiChecking(false);
    }
  };

  const handleOpenOfferModal = (targetAmount?: number) => {
    if (targetAmount && targetAmount > 0) {
      setOfferAmount(targetAmount);
    } else if (selectedApartmentUnit?.unit.price && selectedApartmentUnit.unit.price > 0) {
      setOfferAmount(selectedApartmentUnit.unit.price);
    } else if (listing?.price && offerAmount === 0) {
      setOfferAmount(Number(listing.price));
    }
    setIsOfferModalOpen(true);
  };

  if (isLoading) {
    return (
      <div className="min-h-screen flex items-center justify-center" style={{ background: 'var(--color-bg-deep)' }}>
        <div className="flex flex-col items-center gap-3">
          <div className="w-10 h-10 border-2 border-emerald-500/20 border-t-emerald-500 rounded-full animate-spin" />
          <span className="text-xs tracking-widest uppercase" style={{ color: 'var(--color-text-dim)' }}>Loading listing...</span>
        </div>
      </div>
    );
  }

  if (!listing) {
    return (
      <div className="min-h-screen flex flex-col items-center justify-center p-6 text-center" style={{ background: 'var(--color-bg-deep)', color: 'var(--color-text-main)' }}>
        <h2 className="text-2xl font-bold mb-3">Listing Not Found</h2>
        <p className="text-sm mb-6 max-w-sm" style={{ color: 'var(--color-text-muted)' }}>This listing may have been sold, withdrawn, or has an updated catalog link.</p>
        <Button onClick={onBack} className="bg-emerald-500 text-white rounded-xl">Back to listings</Button>
      </div>
    );
  }

  const media = Array.isArray(listing.media) ? listing.media : [];
  const asset = (listing.asset as any) || {};
  const resSpec = asset.residential_spec || {};
  const landSpec = asset.land_spec || {};
  const vehSpec = asset.vehicle_spec || {};
  const commSpec = asset.commercial_spec || {};

  const isAdmin = Boolean(user?.is_staff || user?.role === 'admin' || user?.role === 'Admin');
  const isOwner = Boolean(
    user?.id &&
      (listing?.owner_user_id === user?.id ||
        listing?.owner?.id === user?.id ||
        listing?.owner?.user === user?.id ||
        listing?.owner === user?.id)
  );
  const isSeller = user?.role === 'seller';
  const canManage = Boolean(isAdmin || isOwner || isSeller);

  const listPrice = Number(listing.price || 0);
  const priceDiffPercent = listPrice > 0 && offerAmount > 0
    ? Math.round(((offerAmount - listPrice) / listPrice) * 100)
    : 0;

  // Category determination
  const rawCat = (listing.category || '').toLowerCase();
  const subType = resSpec.sub_type || listing.sub_type || '';
  const isApartment = rawCat === 'apartment' || subType === 'Apartment' || subType === 'Studio' || subType === 'Penthouse' || subType === 'Duplex' || !!resSpec.apartment_selling_mode || !!resSpec.total_building_floors;
  const isLand = rawCat === 'land' || !!landSpec.upi_number || !!landSpec.zoning_code;
  const isVehicle = rawCat === 'car' || rawCat === 'motorbike' || rawCat === 'vehicle' || !!vehSpec.make;
  const isCommercial = rawCat === 'hotel' || rawCat === 'commercial' || !!commSpec.zoning_type;
  const isHouse = !isLand && !isVehicle && !isCommercial && !isApartment;

  // 3D model detection
  const model3dMedia = media.find((m: any) => m.media_type === 'model_3d' || (typeof m.file === 'string' && (m.file.endsWith('.glb') || m.file.endsWith('.gltf'))));
  const modelUrl = model3dMedia?.file || model3dMedia?.url;

  // Coordinates
  const latitude = Number(asset.latitude) || -1.9441;
  const longitude = Number(asset.longitude) || 30.0619;

  // Apartment floor plan parsing
  let parsedFloorPlan: FloorPlan[] = [];
  if (resSpec.apartment_floor_plan) {
    if (typeof resSpec.apartment_floor_plan === 'string') {
      try {
        parsedFloorPlan = JSON.parse(resSpec.apartment_floor_plan);
      } catch {
        parsedFloorPlan = [];
      }
    } else if (Array.isArray(resSpec.apartment_floor_plan)) {
      parsedFloorPlan = resSpec.apartment_floor_plan;
    }
  }

  // If no floor plan but total_building_floors exists, generate placeholder structure
  if (isApartment && parsedFloorPlan.length === 0 && resSpec.total_building_floors) {
    const numFloors = Number(resSpec.total_building_floors) || 3;
    for (let f = 1; f <= numFloors; f++) {
      parsedFloorPlan.push({
        floor: f,
        units: [
          {
            unitId: `${f}01`,
            bedrooms: 2,
            bathrooms: 2,
            areaSqm: 85,
            view: f === numFloors ? 'Penthouse Skyline View' : f === 1 ? 'Private Garden Patio' : 'City Horizon',
            price: listPrice ? Math.round(listPrice / numFloors) : 500000,
            status: 'available',
          },
          {
            unitId: `${f}02`,
            bedrooms: 3,
            bathrooms: 2,
            areaSqm: 110,
            view: 'Courtyard & Pool',
            price: listPrice ? Math.round(listPrice / numFloors * 1.2) : 650000,
            status: 'available',
          },
        ],
      });
    }
  }

  const nextMedia = () => setActiveMedia((prev) => (prev + 1) % media.length);
  const prevMedia = () => setActiveMedia((prev) => (prev - 1 + media.length) % media.length);

  // Administrative address trail
  const adminHierarchy = [
    asset.province || 'Kigali City',
    asset.district,
    asset.sector,
    asset.cell,
    asset.village,
  ].filter(Boolean);

  return (
    <div
      className="min-h-screen selection:bg-emerald-500/30 pb-28 transition-colors duration-300"
      style={{ background: 'var(--color-bg-deep)', color: 'var(--color-text-main)' }}
    >
      {/* ━━━ MANAGEMENT STUDIO & EDIT MODE BANNER ━━━ */}
      {canManage && (
        <div
          className="border-b px-4 sm:px-8 py-3.5 sticky top-0 z-30 transition-all duration-300 shadow-xl"
          style={{
            borderColor: 'rgba(16, 185, 129, 0.3)',
            background: 'rgba(11, 16, 27, 0.96)',
            backdropFilter: 'blur(20px)',
          }}
        >
          <div className="max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div className="flex items-center gap-3">
              <div className="w-8 h-8 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0">
                <Settings size={16} />
              </div>
              <div>
                <div className="flex items-center gap-2">
                  <span className="font-mono text-[10px] uppercase font-bold tracking-widest text-emerald-400">
                    {isAdmin ? 'ADMINISTRATOR SHOWROOM STUDIO' : 'SELLER / OWNER'}
                  </span>
                  <span className="px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[10px] font-bold">
                    Editing enabled
                  </span>
                </div>
                <p className="text-xs text-zinc-300 mt-0.5">
                  Click the <strong className="text-emerald-400 font-semibold">[Edit Section]</strong> buttons on any card to update live specs, photos, or sovereign details.
                </p>
              </div>
            </div>

            <div className="flex items-center gap-2.5 flex-wrap sm:flex-nowrap">
              {/* Quick Status Selector */}
              <div className="flex items-center gap-1.5 bg-white/[0.04] border border-white/10 px-3 py-1.5 rounded-xl text-xs">
                <span className="text-zinc-400 text-[11px] font-medium">Status:</span>
                <select
                  value={listing.status}
                  onChange={(e) => handleQuickStatusChange(e.target.value)}
                  className="bg-transparent text-emerald-400 font-bold focus:outline-none cursor-pointer text-xs uppercase"
                >
                  <option value="listed" className="bg-zinc-900 text-white">Available</option>
                  <option value="under_negotiation" className="bg-zinc-900 text-white">Under Offer</option>
                  <option value="sold" className="bg-zinc-900 text-white">Sold</option>
                  <option value="withdrawn" className="bg-zinc-900 text-white">Unavailable</option>
                </select>
              </div>

              {/* Add Highlights button */}
              <button
                type="button"
                onClick={() => {
                  setEditingDiscovery(null);
                  setIsDiscoveryModalOpen(true);
                }}
                className="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-bold shadow-md shadow-emerald-500/20 transition-all cursor-pointer active:scale-95"
              >
                <Sparkles size={13} />
                <span>+ Add Highlights</span>
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ━━━ 01 CINEMATIC HERO & 3D/MAP VIEWPORT ━━━ */}
      <div className="relative h-[clamp(430px,68vh,760px)] min-h-[430px] w-full overflow-hidden bg-black">
        {/* Floating Top Controls */}
        <div className="absolute top-6 left-6 right-6 z-20 flex items-center justify-between pointer-events-none">
          <button
            onClick={onBack}
            className="pointer-events-auto flex items-center gap-2 rounded-xl px-4 py-2.5 text-xs font-semibold backdrop-blur-xl transition-all border text-white oneui-press cursor-pointer"
            style={{ borderColor: 'rgba(255,255,255,0.15)', background: 'rgba(0,0,0,0.65)' }}
          >
            <ArrowLeft size={14} /> Back to Catalog
          </button>

          {/* Center Mode Switcher */}
          <div
            className="pointer-events-auto hidden sm:flex items-center gap-1 p-1 rounded-2xl backdrop-blur-xl border"
            style={{ borderColor: 'rgba(255,255,255,0.15)', background: 'rgba(0,0,0,0.7)' }}
          >
            <button
              onClick={() => setHeroMode('photos')}
              className={cn(
                'flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer',
                heroMode === 'photos'
                  ? 'bg-emerald-500 text-white shadow-lg shadow-emerald-500/30'
                  : 'text-zinc-400 hover:text-white',
              )}
            >
              <Layers size={14} /> Photos ({media.length})
            </button>
            <button
              onClick={() => setHeroMode('3d')}
              className={cn(
                'flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-bold transition-all cursor-pointer',
                heroMode === '3d'
                  ? 'bg-emerald-500 text-white shadow-lg shadow-emerald-500/30'
                  : 'text-zinc-400 hover:text-white',
              )}
            >
              <Sparkles size={14} /> 3D Tour
            </button>
            <button
              onClick={() => setHeroMode('map')}
              className={cn(
