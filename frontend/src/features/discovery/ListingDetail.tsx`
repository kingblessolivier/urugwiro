        </div>
      </div>

      {/* MODALS (Offer, Visit, Inquiry, GuestLead) */}
      {isOfferModalOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-xl p-4">
          <div className="border rounded-3xl max-w-lg w-full p-7 space-y-6 bg-zinc-900 text-white">
            <div className="flex justify-between items-center pb-4 border-b border-white/10">
              <h3 className="text-lg font-bold flex items-center gap-2"><DollarSign size={18} className="text-emerald-500" /> Make an Offer</h3>
              <button onClick={() => setIsOfferModalOpen(false)}><XCircle size={20} /></button>
            </div>
            <div className="space-y-4">
              <input
                type="number"
                value={offerAmount}
                onChange={e => setOfferAmount(Number(e.target.value))}
                className="w-full p-3 rounded-xl bg-black border border-white/10 text-white font-mono"
                placeholder="Amount in RWF"
              />
              <Button onClick={() => offerMutation.mutate({ listingId, amount: offerAmount })} className="w-full bg-emerald-500 text-white py-3 rounded-xl font-bold">Submit Proposal</Button>
            </div>
          </div>
        </div>
      )}

      {isVisitModalOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-xl p-4">
          <div className="border rounded-3xl max-w-lg w-full p-7 space-y-6 bg-zinc-900 text-white">
            <div className="flex justify-between items-center pb-4 border-b border-white/10">
              <h3 className="text-lg font-bold flex items-center gap-2"><Calendar size={18} className="text-emerald-500" /> Schedule Visit</h3>
              <button onClick={() => setIsVisitModalOpen(false)}><XCircle size={20} /></button>
            </div>
            <div className="space-y-4">
              <input type="date" value={visitDate} onChange={e => setVisitDate(e.target.value)} className="w-full p-3 rounded-xl bg-black border border-white/10 text-white" />
              <Button onClick={() => visitMutation.mutate({ listingId, date: visitDate })} className="w-full bg-emerald-500 text-white py-3 rounded-xl font-bold">Confirm Appointment</Button>
            </div>
          </div>
        </div>
      )}

      {isInquiryModalOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-xl p-4">
          <div className="border rounded-3xl max-w-lg w-full p-7 space-y-6 bg-zinc-900 text-white">
            <div className="flex justify-between items-center pb-4 border-b border-white/10">
              <h3 className="text-lg font-bold flex items-center gap-2"><MessageCircle size={18} className="text-emerald-500" /> Direct Inquiry</h3>
              <button onClick={() => setIsInquiryModalOpen(false)}><XCircle size={20} /></button>
            </div>
            <div className="space-y-4">
              <textarea
                value={inquiryMessage}
                onChange={e => setInquiryMessage(e.target.value)}
                className="w-full p-3 rounded-xl bg-black border border-white/10 text-white h-32"
                placeholder="Your message..."
              />
              <Button onClick={() => inquiryMutation.mutate({ listingId, message: inquiryMessage })} className="w-full bg-emerald-500 text-white py-3 rounded-xl font-bold">Send Message</Button>
            </div>
          </div>
        </div>
      )}

      {isGuestLeadModalOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/75 backdrop-blur-xl p-4">
          <div className="border rounded-3xl max-w-md w-full p-7 space-y-6 bg-zinc-900 text-white">
            <div className="text-center space-y-2">
              <Heart size={40} className="mx-auto text-red-500" />
              <h3 className="text-xl font-bold">Save to Favorites</h3>
              <p className="text-sm text-zinc-400">Please provide your details to save this property to your personalized shortlist.</p>
            </div>
            <form onSubmit={handleGuestLeadSubmit} className="space-y-4">
              <input type="text" value={guestName} onChange={e => setGuestName(e.target.value)} placeholder="Full Name" className="w-full p-3 rounded-xl bg-black border border-white/10 text-white" required />
              <input type="email" value={guestEmail} onChange={e => setGuestEmail(e.target.value)} placeholder="Email Address" className="w-full p-3 rounded-xl bg-black border border-white/10 text-white" />
              <input type="tel" value={guestPhone} onChange={e => setGuestPhone(e.target.value)} placeholder="Phone Number" className="w-full p-3 rounded-xl bg-black border border-white/10 text-white" required />
              <Button type="submit" disabled={guestLoading} className="w-full bg-emerald-500 text-white py-3 rounded-xl font-bold">
                {guestLoading ? 'Registering...' : 'Save Asset'}
              </Button>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};

// Helper Component for Trust Items
const TrustItem: React.FC<{ label: string; status: 'verified' | 'pending' }> = ({ label, status }) => (
  <div className="flex items-center justify-between p-3 rounded-xl border border-white/10 bg-white/[0.02]">
    <span className="text-xs text-zinc-300">{label}</span>
    {status === 'verified' ? (
      <span className="flex items-center gap-1 text-[10px] font-bold text-emerald-500 uppercase tracking-wider">
        <CheckCircle2 size={12} /> Verified
      </span>
    ) : (
      <span className="flex items-center gap-1 text-[10px] font-bold text-zinc-500 uppercase tracking-wider">
        <div className="w-1.5 h-1.5 rounded-full bg-zinc-600" /> Pending
      </span>
    )}
  </div>
);

// Helper Component for Simple Spec Cards
const SpecCard: React.FC<{ icon: any; label: string; value: string }> = ({ icon: Icon, label, value }) => (
  <div className="p-4 rounded-2xl border border-white/10 bg-white/[0.02] flex items-center gap-4 transition-all hover:border-emerald-500/40">
    <div className="p-2 rounded-lg bg-emerald-500/10 text-emerald-500">
      <Icon size={18} />
    </div>
    <div>
      <p className="text-[10px] uppercase font-bold text-zinc-500 tracking-wider">{label}</p>
      <p className="text-sm font-bold text-white">{value}</p>
    </div>
  </div>
);

export default ListingDetail;
