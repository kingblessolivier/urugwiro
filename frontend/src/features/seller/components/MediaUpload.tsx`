import React, { useState, useCallback } from 'react';
import {
  Upload, X, GripVertical, Image as ImageIcon,
  FileText, CheckCircle2, AlertCircle, Loader2,
  Plus, MoveUp, MoveDown
} from 'lucide-react';
import { Button } from '../ui/Button';
import { Badge } from '../ui/Badge';
import { cn } from '../../lib/utils';
import { MediaFile, MediaCategory } from './media-types';

interface MediaUploadProps {
  onMediaUpdate: (media: MediaFile[]) => void;
  initialMedia?: MediaFile[];
}

export const MediaUpload = ({ onMediaUpdate, initialMedia = [] }: MediaUploadProps) => {
  const [media, setMedia] = useState<MediaFile[]>(initialMedia);

  const onFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = Array.from(e.target.files || []);
    const newMedia: MediaFile[] = files.map((file, index) => ({
      id: Math.random().toString(36).substr(2, 9),
      file,
      preview: URL.createObjectURL(file),
      category: 'Exterior',
      order: media.length + index,
      caption: '',
      status: 'uploading',
      progress: 0,
    }));

    const updated = [...media, ...newMedia];
    setMedia(updated);
    onMediaUpdate(updated);

    // Simulate upload progress for each file
    newMedia.forEach((item, idx) => {
      let progress = 0;
      const interval = setInterval(() => {
        progress += 10;
        setMedia(prev => prev.map(m =>
          m.id === item.id ? { ...m, progress, status: progress === 100 ? 'completed' : 'uploading' } : m
        ));
        if (progress >= 100) clearInterval(interval);
      }, 200);
    });
  };

  const removeMedia = (id: string) => {
    const updated = media.filter(m => m.id !== id);
    setMedia(updated);
    onMediaUpdate(updated);
  };

  const updateCategory = (id: string, cat: MediaCategory) => {
    const updated = media.map(m => m.id === id ? { ...m, category: cat } : m);
    setMedia(updated);
    onMediaUpdate(updated);
  };

  return (
    <div className="space-y-8">
      {/* Upload Zone */}
      <div
        className="border-2 border-dashed border-slate-200 rounded-2xl p-12 text-center hover:border-emerald-500 transition-all cursor-pointer group bg-slate-50/50"
        onClick={() => document.getElementById('media-input')?.click()}
      >
        <input
          id="media-input"
          type="file"
          multiple
          accept="image/*,video/*"
          className="hidden"
          onChange={onFileChange}
        />
        <div className="w-16 h-16 bg-white rounded-2xl shadow-sm flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300">
          <Upload className="text-emerald-600" size={28} />
        </div>
        <h3 className="text-lg font-bold text-slate-900">Upload High-Res Media</h3>
        <p className="text-slate-500 text-sm mt-1">Drag and drop photos, drone footage, or 3D tours</p>
        <p className="text-xs text-slate-400 mt-4">Max file size: 50MB per file</p>
      </div>

      {/* Media Grid */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {media.map((item) => (
          <div key={item.id} className="bg-white rounded-2xl border border-slate-200 overflow-hidden group relative">
            <div className="relative aspect-video overflow-hidden">
              <img src={item.preview} className="w-full h-full object-cover" alt="preview" />

              {/* Upload Overlay */}
              {item.status === 'uploading' && (
                <div className="absolute inset-0 bg-black/40 backdrop-blur-sm flex flex-col items-center justify-center text-white">
                  <Loader2 className="animate-spin mb-2" size={24} />
                  <span className="text-xs font-medium">{item.progress}%</span>
                </div>
              )}

              <button
                onClick={() => removeMedia(item.id)}
                className="absolute top-2 right-2 p-1.5 bg-white/90 rounded-full text-slate-500 hover:text-red-500 transition-colors shadow-sm"
              >
                <X size={14} />
              </button>
            </div>

            <div className="p-4 space-y-4">
              <div className="flex items-center justify-between">
                <select
                  value={item.category}
                  onChange={(e) => updateCategory(item.id, e.target.value as MediaCategory)}
                  className="text-xs font-semibold text-slate-600 bg-slate-100 border-none rounded-md px-2 py-1 outline-none focus:ring-2 focus:ring-emerald-500/20"
                >
                  <option value="Exterior">Exterior</option>
                  <option value="Interior">Interior</option>
                  <option value="Drone">Drone</option>
                  <option value="FloorPlan">Floor Plan</option>
                  <option value="Video">Video</option>
                  <option value="Other">Other</option>
                </select>
                <Badge variant={item.status === 'completed' ? 'success' : 'neutral'}>
                  {item.status === 'completed' ? 'Ready' : 'Uploading'}
                </Badge>
              </div>
              <input
                type="text"
                placeholder="Add a caption..."
                className="w-full text-sm p-2 bg-slate-50 border border-slate-100 rounded-lg outline-none focus:border-emerald-500 transition-all"
                value={item.caption}
                onChange={(e) => {
                  const updated = media.map(m => m.id === item.id ? { ...m, caption: e.target.value } : m);
                  setMedia(updated);
                  onMediaUpdate(updated);
                }}
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  );
};
