                className="h-[500px] w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div className="absolute inset-0 bg-gradient-to-t from-[#05070b] via-transparent to-transparent" />
              <div className="absolute bottom-8 left-8 right-8 rounded-3xl border border-white/10 bg-black/60 p-6 backdrop-blur-2xl">
                <div className="flex items-center justify-between mb-2">
                  <span className="text-xs font-bold uppercase tracking-[0.2em] text-emerald-400">Digital Showroom</span>
                  <CheckCircle2 size={16} className="text-emerald-400" />
