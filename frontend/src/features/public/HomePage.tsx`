        <div className="mb-12 flex items-end justify-between">
          <div>
            <p className="text-xs font-bold uppercase tracking-[0.3em] text-emerald-500 mb-3">Discovery</p>
            <h2 className="text-4xl font-bold tracking-tight">Browse by category</h2>
          </div>
          <Button variant="ghost" className="text-emerald-400 hover:text-emerald-300 flex items-center gap-2">
            View all <ArrowRight size={16} />
