                <p className="text-xl font-bold text-white">Immersive Property Discovery</p>
                <p className="text-sm text-zinc-400 mt-1">High-trust, information-rich listings for an informed decision.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* 02 CATEGORIES GRID */}
