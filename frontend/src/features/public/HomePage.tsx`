              <p className="leading-relaxed text-zinc-400">{prop.description}</p>
            </div>
          ))}
        </div>
      </section>

      {/* 05 FINAL CTA SECTION */}
      <section className="mx-auto max-w-5xl px-6 pb-24 pt-12 text-center lg:px-12">
        <div className="relative overflow-hidden rounded-[3rem] border border-white/10 bg-gradient-to-br from-emerald-600/20 to-transparent p-12 backdrop-blur-3xl">
