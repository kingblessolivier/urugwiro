              Login
            </button>
          </div>
        </nav>
      )}

      <div className={view !== 'login' && view !== 'register' ? 'pt-16' : ''}>
        {view === 'discovery' && <DiscoveryPage onListingClick={navigateToListing} />}
        {view === 'listing-detail' && <ListingDetail listingId={selectedListingId || ''} onBack={() => setView('discovery')} />}
        {view === 'settings' && <SystemSettings />}
        {view === 'admin-hub' && <AdminHub setView={setView} />}
        {view === 'admin-users' && <AdminUserManager />}
        {view === 'admin-properties' && <AdminPropertyManager />}
        {view === 'admin-tenants' && <AdminTenantManager />}
        {view === 'admin-owners' && <AdminOwnerManager />}
        {view === 'admin-agents' && <AdminAgentManager />}
        {view === 'admin-sellers' && <AdminSellerManager />}
        {view === 'admin-leases' && <AdminLeaseManager />}
        {view === 'admin-maintenance' && <AdminMaintenance />}
        {view === 'admin-inbox' && <AdminInbox />}
        {view === 'agent-dashboard' && <AgentLaunchpad />}
        {view === 'agent-properties' && <AgentPropertyManager />}
        {view === 'agent-visits' && <AgentVisitKanban />}
        {view === 'agent-offers' && <AgentOfferManager />}
        {view === 'seller-dashboard' && <SellerLaunchpad />}
        {view === 'seller-wizard' && <ListingWizard />}
        {view === 'seller-offers' && <SellerOfferManager />}
        {view === 'seller-inquiries' && <SellerInquiryManager />}
        {view === 'owner-dashboard' && <OwnerLaunchpad />}
        {view === 'owner-maintenance' && <OwnerMaintenance />}
        {view === 'admin-logs' && <SystemLogsPage />}
        {view === 'admin-announcements' && <AnnouncementManager />}
        {view === 'admin-reports' && <AdminReports />}
        {view === 'admin-enquiries' && <EnquiryManager />}
        {view === 'admin-verification' && <VerificationWorkspace />}
        {view === 'login' && <LoginPage />}
        {view === 'register' && <RegisterPage />}
        {view === 'about' && <AboutPage />}
        {view === 'contact' && <ContactPage />}
        {view === 'updates' && <UpdatesPage />}
      </div>
    </div>
  );
