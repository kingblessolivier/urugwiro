import React, { useState } from 'react';
import DiscoveryPage from './features/discovery/DiscoveryPage';
import ListingDetail from './features/discovery/ListingDetail';
import SystemSettings from './features/admin/SystemSettings';
import AdminHub from './features/admin/AdminHub';
import AdminUserManager from './features/admin/AdminUserManager';
import AdminPropertyManager from './features/admin/AdminPropertyManager';
import AdminTenantManager from './features/admin/AdminTenantManager';
import AdminOwnerManager from './features/admin/AdminOwnerManager';
import AdminAgentManager from './features/admin/AdminAgentManager';
import AdminSellerManager from './features/admin/AdminSellerManager';
import AdminLeaseManager from './features/admin/AdminLeaseManager';
import AdminMaintenance from './features/admin/AdminMaintenance';
import AdminInbox from './features/admin/AdminInbox';
import AgentLaunchpad from './features/agent/AgentLaunchpad';
import AgentPropertyManager from './features/agent/AgentPropertyManager';
import AgentVisitKanban from './features/agent/AgentVisitKanban';
import AgentOfferManager from './features/agent/AgentOfferManager';
import SellerLaunchpad from './features/seller/SellerLaunchpad';
import ListingWizard from './features/seller/ListingWizard';
import SellerOfferManager from './features/seller/SellerOfferManager';
import SellerInquiryManager from './features/seller/SellerInquiryManager';
import OwnerLaunchpad from './features/owner/OwnerLaunchpad';
import OwnerMaintenance from './features/owner/OwnerMaintenance';
import SystemLogsPage from './features/admin/SystemLogsPage';
import AnnouncementManager from './features/admin/AnnouncementManager';
import AdminReports from './features/admin/AdminReports';
import EnquiryManager from './features/admin/EnquiryManager';
import VerificationWorkspace from './features/admin/VerificationWorkspace';
import LoginPage from './features/auth/LoginPage';
import RegisterPage from './features/auth/RegisterPage';
import AboutPage from './features/public/AboutPage';
import ContactPage from './features/public/ContactPage';
import UpdatesPage from './features/public/UpdatesPage';
import './App.css';

function App() {
  const [view, setView] = useState<'discovery' | 'listing-detail' | 'settings' | 'admin-hub' | 'admin-users' | 'admin-properties' | 'admin-tenants' | 'admin-owners' | 'admin-agents' | 'admin-sellers' | 'admin-leases' | 'admin-maintenance' | 'admin-inbox' | 'admin-logs' | 'admin-announcements' | 'admin-reports' | 'admin-enquiries' | 'admin-verification' | 'agent-dashboard' | 'agent-properties' | 'agent-visits' | 'agent-offers' | 'seller-dashboard' | 'seller-wizard' | 'seller-offers' | 'seller-inquiries' | 'owner-dashboard' | 'owner-maintenance' | 'tenant-dashboard' | 'login' | 'register' | 'about' | 'contact' | 'updates'>('discovery');
  const [selectedListingId, setSelectedListingId] = useState<string | null>(null);

  const navigateToListing = (id: string) => {
    setSelectedListingId(id);
    setView('listing-detail');
  };

  return (
    <div className="App bg-black min-h-screen text-white">
      {/* Simple Navigation for Demo/Development */}
      {view !== 'login' && view !== 'register' && view !== 'listing-detail' && (
        <nav className="fixed top-0 left-0 right-0 z-50 flex justify-center p-4 pointer-events-none">
          <div className="flex gap-4 bg-zinc-900/80 backdrop-blur-md border border-zinc-800 p-1 rounded-full pointer-events-auto">
            <button
              onClick={() => setView('discovery')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'discovery' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Discovery
            </button>
            <button
              onClick={() => setView('about')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'about' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              About
            </button>
            <button
              onClick={() => setView('updates')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'updates' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Updates
            </button>
            <button
              onClick={() => setView('contact')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'contact' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Contact
            </button>
            <div className="w-px h-6 bg-zinc-700 mx-2" />
            <button
              onClick={() => setView('admin-hub')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'admin-hub' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Admin Hub
            </button>
            <button
              onClick={() => setView('admin-users')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'admin-users' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Users
            </button>
            <button
              onClick={() => setView('admin-properties')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'admin-properties' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Properties
            </button>
            <button
              onClick={() => setView('admin-tenants')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'admin-tenants' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Tenants
            </button>
            <button
              onClick={() => setView('admin-owners')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'admin-owners' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Owners
            </button>
            <button
              onClick={() => setView('admin-agents')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'admin-agents' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Agents
            </button>
            <button
              onClick={() => setView('admin-sellers')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'admin-sellers' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Sellers
            </button>
            <button
              onClick={() => setView('admin-leases')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'admin-leases' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Leases
            </button>
            <button
              onClick={() => setView('admin-maintenance')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'admin-maintenance' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Maintenance
            </button>
            <button
              onClick={() => setView('admin-inbox')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'admin-inbox' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Messages
            </button>
            <button
              onClick={() => setView('agent-dashboard')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'agent-dashboard' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Agent Dash
            </button>
            <button
              onClick={() => setView('agent-properties')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'agent-properties' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Agent Props
            </button>
            <button
              onClick={() => setView('agent-visits')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'agent-visits' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Agent Visits
            </button>
            <button
              onClick={() => setView('agent-offers')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'agent-offers' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Agent Offers
            </button>
            <button
              onClick={() => setView('seller-dashboard')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'seller-dashboard' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Seller Dash
            </button>
            <button
              onClick={() => setView('seller-wizard')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'seller-wizard' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              List Property
            </button>
            <button
              onClick={() => setView('seller-offers')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'seller-offers' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Seller Offers
            </button>
            <button
              onClick={() => setView('seller-inquiries')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'seller-inquiries' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Seller Inquiries
            </button>
            <button
              onClick={() => setView('owner-dashboard')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'owner-dashboard' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Owner Dash
            </button>
            <button
              onClick={() => setView('owner-maintenance')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'owner-maintenance' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Owner Maint
            </button>
            <button
              onClick={() => setView('admin-logs')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'admin-logs' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Logs
            </button>
            <button
              onClick={() => setView('admin-announcements')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'admin-announcements' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Announcements
            </button>
            <button
              onClick={() => setView('admin-reports')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'admin-reports' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Reports
            </button>
            <button
              onClick={() => setView('admin-enquiries')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'admin-enquiries' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
            >
              Enquiries
            </button>
            <button
              onClick={() => setView('settings')}
              className={`px-4 py-1 rounded-full text-sm font-medium transition-all ${view === 'settings' ? 'bg-white text-black' : 'text-zinc-400 hover:text-white'}`}
