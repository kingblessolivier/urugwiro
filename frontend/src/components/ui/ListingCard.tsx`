import React from 'react';
import { MapPin, ShieldCheck, CheckCircle2, Eye } from 'lucide-react';
import { cn } from '../../lib/utils';

export interface ListingCardData {
  id: string;
  title: string;
  price: number;
  currency: string;
  location: string;
  listing_type: string;
  verification_level?: 'none' | 'submitted' | 'verified' | 'professional';
  media?: { url?: string; file?: string; category?: string }[];
  specs?: Record<string, string | number>;
  isFeatured?: boolean;
}

interface ListingCardProps {
  listing: ListingCardData;
  onClick?: (id: string) => void;
}

const ListingCard: React.FC<ListingCardProps> = ({ listing, onClick }) => {
  const image = listing.media?.[0]?.url || listing.media?.[0]?.file || 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&q=80&w=900';

  const getVerificationBadge = () => {
    switch (listing.verification_level) {
      case 'professional':
        return (
          <span className="flex items-center gap-1 rounded-full border border-emerald-400/30 bg-emerald-500/20 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-emerald-300 backdrop-blur-md">
            <ShieldCheck size={12} /> Professionally Inspected
          </span>
        );
      case 'verified':
        return (
          <span className="flex items-center gap-1 rounded-full border border-emerald-400/30 bg-emerald-500/20 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-emerald-300 backdrop-blur-md">
            <ShieldCheck size={12} /> Urugwiro Verified
          </span>
        );
      case 'submitted':
        return (
          <span className="flex items-center gap-1 rounded-full border border-white/20 bg-white/10 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-zinc-300 backdrop-blur-md">
            <CheckCircle2 size={12} /> Docs Submitted
          </span>
        );
      default:
        return null;
    }
  };

  return (
    <article
      className="group relative flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-[#0b0d12] transition-all duration-500 hover:border-emerald-500/40 hover:shadow-[0_0_30px_rgba(16,185,129,0.15)]"
      onClick={() => onClick?.(listing.id)}
    >
      {/* Media Section */}
      <div className="relative aspect-[4/3] overflow-hidden">
        <img
          src={image}
          alt={listing.title}
          className="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
        />
        <div className="absolute inset-0 bg-gradient-to-t from-[#0b0d12] via-transparent to-transparent opacity-60" />

        {/* Badges */}
        <div className="absolute left-4 top-4 flex flex-col gap-2">
          <span className="rounded-full border border-white/20 bg-black/60 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-white backdrop-blur-md">
            {listing.listing_type}
          </span>
          {getVerificationBadge()}
        </div>

        <div className="absolute right-4 top-4 rounded-full bg-black/40 p-2 text-white backdrop-blur-md opacity-0 transition-opacity group-hover:opacity-100">
          <Eye size={16} />
        </div>
      </div>

      {/* Content Section */}
      <div className="flex flex-col p-5">
        <div className="mb-4">
          <h3 className="text-lg font-bold leading-tight text-white group-hover:text-emerald-400 transition-colors">
            {listing.title}
          </h3>
          <p className="mt-1 flex items-center gap-1 text-sm text-zinc-400">
            <MapPin size={14} className="text-emerald-500" /> {listing.location}
          </p>
        </div>

        {/* Structured Specifications */}
        <div className="mb-5 grid grid-cols-2 gap-y-2 gap-x-4 border-t border-white/5 pt-4 text-[13px] text-zinc-400">
          {Object.entries(listing.specs || {}).map(([key, value]) => (
            <div key={key} className="flex items-center justify-between gap-2">
              <span className="opacity-60">{key}:</span>
              <span className="font-medium text-zinc-200">{value}</span>
            </div>
          ))}
        </div>

        {/* Price and CTA */}
        <div className="mt-auto flex items-end justify-between border-t border-white/5 pt-4">
          <div>
            <p className="text-[10px] uppercase tracking-widest text-zinc-500">Price</p>
            <p className="text-xl font-bold text-white">
              {listing.price.toLocaleString()} <span className="text-sm font-normal text-zinc-400">{listing.currency}</span>
            </p>
          </div>
          <div className="text-xs font-semibold text-emerald-500 transition-all group-hover:translate-x-1">
            View Details →
          </div>
        </div>
      </div>
    </article>
  );
};

export { ListingCard };
