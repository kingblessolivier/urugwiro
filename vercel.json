{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://urugwiro-api-production-b6d5.up.railway.app/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://urugwiro-api-production-b6d5.up.railway.app/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
